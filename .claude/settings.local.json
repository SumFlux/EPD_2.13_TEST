{
  "permissions": {
    "allow": [
      "Bash(where:*)",
      "Bash(py:*)",
      "Bash(if not exist .env copy .env.example .env)",
      "Bash(.venvScriptspython:*)",
      "Bash(mysql:*)",
      "Bash(sc query:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(./venv/Scripts/python:*)"
