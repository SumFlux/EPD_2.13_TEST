#include "Driver/EPD_Driver.h"
#include "Input/InputManager.h"
#include "Network/NetworkManager.h"
#include "Network/ImageFetcher.h"
#include "Version.h"
#include <Arduino.h>

// ==========================================
// Configuration (硬编码调试用)
// ==========================================
// WARNING: 这些凭证仅用于开发调试！
// 生产环境请使用 NVS (Preferences) 或配网功能存储凭证
// TODO: 实现 SmartConfig 或 Web 配网功能
// ==========================================
#define WIFI_SSID "SumHome"          // 修改为你的 WiFi 名称
#define WIFI_PASSWORD "94449999"      // 修改为你的 WiFi 密码
#define API_BASE_URL "http://192.168.31.57:8000"  // 修改为后端服务器地址
#define DEVICE_ID "0BFB78"                // 修改为你的设备 ID
#define DEVICE_PASSWORD "123456"          // 修改为你的设备密码

// ==========================================
// Objects
// ==========================================
EPD_Driver epd;
InputManager input;
NetworkManager network;
ImageFetcher imageFetcher(API_BASE_URL);

// ==========================================
// State
// ==========================================
int g_encCounter = 0; // 0-999
int g_vibCounter = 0; // 0-99

char g_versionStr[32];

// Refresh Counters
int g_fastCount = 0;
int g_flickerCount = 0;

// Network & Image State
static uint8_t* g_bitmapBuffer = nullptr;
static const size_t BITMAP_SIZE = 2756;
static std::vector<ImageInfo> g_imageList;
static int g_currentImageIndex = -1;
static bool g_systemReady = false;

// ==========================================
// Helper Functions
// ==========================================

void displayProgress(const char* message, int step, int total) {
  // 使用局部快刷（不闪烁）
  epd.getDisplay().setPartialWindow(0, 0, 212, 104);

  epd.getDisplay().firstPage();
  do {
    epd.getDisplay().fillScreen(GxEPD_WHITE);
    epd.getDisplay().setTextColor(GxEPD_BLACK);

    // 标题（考虑偏移）
    epd.getDisplay().setTextSize(2);
    epd.getDisplay().setCursor(10, 28);  // 18 (OFFSET_Y) + 10
    epd.getDisplay().print("Starting...");

    // 进度条（考虑偏移）
    int barWidth = 180;
    int barHeight = 20;
    int barX = 16;
    int barY = 58;  // 40 + 18 (OFFSET_Y)
    int progress = (step * barWidth) / total;

    epd.getDisplay().drawRect(barX, barY, barWidth, barHeight, GxEPD_BLACK);
    epd.getDisplay().fillRect(barX + 2, barY + 2, progress - 4, barHeight - 4, GxEPD_BLACK);

    // 步骤信息（考虑偏移）
    epd.getDisplay().setTextSize(1);
    epd.getDisplay().setCursor(10, 88);  // 70 + 18
    epd.getDisplay().print("Step ");
    epd.getDisplay().print(step);
    epd.getDisplay().print("/");
    epd.getDisplay().print(total);

    // 当前操作（考虑偏移）
    epd.getDisplay().setCursor(10, 103);  // 85 + 18
    epd.getDisplay().print(message);
  } while (epd.getDisplay().nextPage());

  // 不需要 delay，局部刷新很快
}

void updateScreen(bool forceFlicker) {
  // Refresh Strategy Logic
  if (forceFlicker) {
    // 1. Light refresh clear (full screen)
    epd.runLight(0);

    // 2. Redraw info area
    epd.drawInfo(g_versionStr, g_encCounter, g_vibCounter, false);
    return;
  }

  g_fastCount++;

  if (g_fastCount > 5) {
    // Trigger FLICKER Partial
    g_fastCount = 0;
    epd.drawInfo(g_versionStr, g_encCounter, g_vibCounter, true);
  } else {
    // Trigger FAST Partial
    epd.drawInfo(g_versionStr, g_encCounter, g_vibCounter, false);
  }
}

void displayError(const char* message) {
  Serial.print("Error: ");
  Serial.println(message);

  epd.runLight(0);
  epd.getDisplay().setFullWindow();
  epd.getDisplay().firstPage();
  do {
    epd.getDisplay().fillScreen(GxEPD_WHITE);
    epd.getDisplay().setTextColor(GxEPD_BLACK);
    epd.getDisplay().setTextSize(2);
    epd.getDisplay().setCursor(10, 40);
    epd.getDisplay().print("Error:");
    epd.getDisplay().setCursor(10, 60);
    epd.getDisplay().print(message);
  } while (epd.getDisplay().nextPage());
}

bool fetchAndDisplayImage(int imageIndex) {
  if (imageIndex < 0 || static_cast<size_t>(imageIndex) >= g_imageList.size()) {
    Serial.println("Error: Invalid image index");
    return false;
  }

  ImageInfo& img = g_imageList[imageIndex];

  // 下载位图数据
  if (!imageFetcher.downloadBitmap(img.id, g_bitmapBuffer, BITMAP_SIZE)) {
    displayError("Download Failed");
    return false;
  }

  // 显示位图（首次不使用闪烁，切换时使用闪烁）
  bool useFlicker = (g_currentImageIndex != -1);
  epd.drawBitmap(g_bitmapBuffer, BITMAP_SIZE, useFlicker);

  g_currentImageIndex = imageIndex;
  return true;
}

// ==========================================
// Setup
// ==========================================

void setup() {
  // 禁用看门狗（防止 WiFi 连接时重启）
  disableCore0WDT();
  disableCore1WDT();

  Serial.begin(115200);
  delay(500);

  Serial.println("--- INFINITY TAG V2 (Network) ---");

  // Format Version String
  snprintf(g_versionStr, sizeof(g_versionStr), "Firmware: v%d.%d.%d.%d",
           VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, VERSION_BUILD);
  Serial.println(g_versionStr);

  // Step 1: Init Drivers
  epd.begin();
  input.begin();
  displayProgress("Init hardware...", 1, 5);
  Serial.println("[OK] Hardware initialized");

  // Step 2: Allocate PSRAM buffer
  displayProgress("Allocate memory...", 2, 5);
  Serial.println("Allocating bitmap buffer...");
  if (psramFound()) {
    Serial.println("PSRAM detected, using ps_malloc");
    g_bitmapBuffer = (uint8_t*)ps_malloc(BITMAP_SIZE);
  } else {
    Serial.println("PSRAM not found, using malloc");
    g_bitmapBuffer = (uint8_t*)malloc(BITMAP_SIZE);
  }

  if (g_bitmapBuffer == nullptr) {
    Serial.println("FATAL: Failed to allocate bitmap buffer!");
    displayError("Memory Error");
    while (1) { delay(1000); }
  }
  Serial.println("[OK] Memory allocated");

  // Step 3: Connect to WiFi
  displayProgress("Connect WiFi...", 3, 5);
  Serial.println("Connecting to WiFi...");

  // 添加异常处理
  try {
    network.begin(WIFI_SSID, WIFI_PASSWORD);

    // 增加超时时间到 30 秒
    if (!network.waitForConnection(30000)) {
      displayError("WiFi Failed");
      g_systemReady = false;
      Serial.println("--- READY (No Network) ---");
      return;
    }
  } catch (...) {
    Serial.println("WiFi exception caught!");
    displayError("WiFi Exception");
    g_systemReady = false;
    return;
  }
  Serial.println("[OK] WiFi connected");

  // Step 4: Authenticate with backend
  displayProgress("Authenticate...", 4, 5);
  Serial.println("Authenticating...");
  if (!imageFetcher.authenticate(DEVICE_ID, DEVICE_PASSWORD)) {
    displayError("Auth Failed");
    g_systemReady = false;
    Serial.println("--- READY (No Auth) ---");
    return;
  }
  Serial.println("[OK] Authenticated");

  // Step 5: Complete
  displayProgress("Ready!", 5, 5);
  g_systemReady = true;
  Serial.println("--- SYSTEM READY ---");

  delay(1000); // 显示完成状态

  // Display ready message
  epd.runLight(0);
  epd.getDisplay().setFullWindow();
  epd.getDisplay().firstPage();
  do {
    epd.getDisplay().fillScreen(GxEPD_WHITE);
    epd.getDisplay().setTextColor(GxEPD_BLACK);
    epd.getDisplay().setTextSize(2);
    epd.getDisplay().setCursor(10, 40);
    epd.getDisplay().print("System Ready");
    epd.getDisplay().setTextSize(1);
    epd.getDisplay().setCursor(10, 70);
    epd.getDisplay().print("Press button to");
    epd.getDisplay().setCursor(10, 82);
    epd.getDisplay().print("fetch images");
  } while (epd.getDisplay().nextPage());
}

// ==========================================
// Main Loop
// ==========================================

void loop() {
  // 1. Check Input
  int8_t delta = input.getEncoderDelta();
  bool vibe = input.isVibrationTriggered();
  bool btn = input.isButtonPressed();

  // 2. Button Logic: Fetch image list and display first image
  if (btn) {
    Serial.println("[BTN] Fetch images");

    // Check system status
    if (!g_systemReady) {
      displayError("System Not Ready");
      delay(2000);
      return;
    }

    if (!network.isConnected()) {
      displayError("WiFi Disconnected");
      delay(2000);
      return;
    }

    // Fetch image list
    if (!imageFetcher.fetchImageList(g_imageList)) {
      displayError("Fetch Failed");
      delay(2000);
      return;
    }

    // Check if list is empty
    if (g_imageList.empty()) {
      displayError("No Images");
      delay(2000);
      return;
    }

    // Display first image
    if (fetchAndDisplayImage(0)) {
      Serial.println("First image displayed");
    }

    delay(500); // Debounce
    return;
  }

  // 3. Encoder Logic: Switch images (if list is loaded)
  if (delta != 0 && !g_imageList.empty()) {
    Serial.print("[ENC] Switch image: ");

    // Calculate new index with wrapping
    int newIndex = g_currentImageIndex + delta;

    // Wrap boundaries
    if (newIndex < 0) {
      newIndex = g_imageList.size() - 1;
    } else if (newIndex >= g_imageList.size()) {
      newIndex = 0;
    }

    Serial.print(newIndex);
    Serial.print(" (delta=");
    Serial.print(delta);
    Serial.println(")");

    // Fetch and display new image
    if (fetchAndDisplayImage(newIndex)) {
      Serial.println("Image switched");
    }

    delay(200); // Debounce
    return;
  }

  // 4. Vibration Logic (legacy counter, 0-99, Wrap, Increment Only)
  if (vibe) {
    g_vibCounter++;
    if (g_vibCounter > 99)
      g_vibCounter = 0; // Wrap 99->0
    Serial.printf("[VIB] %d\n", g_vibCounter);
  }

  delay(10);
}