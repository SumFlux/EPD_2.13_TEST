# ====================================
# 应用基础配置
# ====================================
APP_NAME="Infinity Tag Backend"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=False

# ====================================
# 数据库配置
# ====================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=infinitytag
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=infinity_tag
MYSQL_ROOT_PASSWORD=your_root_password_here

# ====================================
# Redis 配置
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ====================================
# AI 服务配置（可通过管理接口动态修改）
# ====================================
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=doubao-seed-1-6-250615
AI_BASE_URL=https://www.dmxapi.cn/v1
AI_TIMEOUT=30

# ====================================
# JWT 配置
# ====================================
# 务必修改为随机生成的密钥！可以使用: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# ====================================
# 安全配置
# ====================================
FORCE_HTTPS=True
ALLOWED_HOSTS=["infinitytag.app","api.infinitytag.app"]
HMAC_SECRET_LENGTH=32
PASSWORD_MIN_LENGTH=8

# ====================================
# 设备激活配置 (必填)
# ====================================
# 设备码生成盐值（必填，使用随机字符串，如: openssl rand -hex 16）
DEVICE_CODE_SALT=your-device-code-salt-change-me
# 初始密码生成盐值（必填，使用随机字符串）
INIT_PWD_SALT=your-init-password-salt-change-me

# ====================================
# 管理员配置 (必填)
# ====================================
ADMIN_USERNAME=admin
# 管理员密码哈希（必填，使用 bcrypt 生成）
# 生成命令: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash-here
ADMIN_JWT_EXPIRATION_HOURS=24

# ====================================
# 限流配置
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================================
# 黄历配置
# ====================================
ALMANAC_CACHE_DAYS=5
ALMANAC_HISTORY_DAYS=30

# ====================================
# CORS 配置
# ====================================
CORS_ORIGINS=["https://infinitytag.app","https://www.infinitytag.app"]
